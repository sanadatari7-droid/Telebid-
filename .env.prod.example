# Copy this to .env.prod (gitignored — never commit real values) before
# running the production on-premises deployment. Every command in
# infra/on-premises/README.md passes --env-file .env.prod explicitly, so
# these values reach both docker-compose.prod.yml's own interpolation
# (${POSTGRES_PASSWORD}, ${SITE_ADDRESS}) and the backend container's
# environment.

# ── Site address ─────────────────────────────────────────────────────────────
# A real domain (e.g. bids.yourcompany.com) that already points its DNS A
# record at this server — Caddy will automatically obtain a Let's Encrypt
# certificate for it, no further TLS setup needed.
#
# No public domain / LAN-only install? Set this to your server's LAN IP or
# hostname and see the "LAN-only / no domain" section in
# infra/on-premises/README.md — it needs one extra line added to
# infra/on-premises/Caddyfile before you build.
SITE_ADDRESS=bids.yourcompany.com

# ── Database password ─────────────────────────────────────────────────────────
# Generate a strong one: openssl rand -hex 32
# Used for both Postgres's own account and the backend's DATABASE_URL —
# set it once here, docker-compose.prod.yml composes both from this value.
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# ── JWT signing key ───────────────────────────────────────────────────────────
# Generate a strong one: openssl rand -hex 32
# Anyone with this value can forge valid login sessions — treat it like a
# master password. Rotating it invalidates every existing login session.
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Leave blank to run in demo mode: login verification codes are returned
# directly in the API response instead of emailed — fine for an initial
# install, but every real user will need SMTP configured before this is
# usable without someone reading codes out of network logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TeleBid Enterprise <noreply@yourcompany.com>
SMTP_TLS=true

# ── AI Bid/No-Bid Advisor (optional) ─────────────────────────────────────────
# Get a key at https://console.anthropic.com. Leave blank to run without
# it — the opportunity detail page shows "AI advisor not configured"
# instead of the recommendation panel; nothing else is affected.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

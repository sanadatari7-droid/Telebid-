# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://telebid:telebid123@postgres:5432/telebid

# ── JWT Security ──────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-long-random-string-here!!
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Password Hashing ─────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# For Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_TLS=true
# For Office365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_TLS=true
# Leave blank to run in demo mode (OTP shown on screen)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TeleBid Enterprise <noreply@telebid.com>
SMTP_TLS=true

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

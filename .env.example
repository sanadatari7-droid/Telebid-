# Used by the DEV docker-compose.yml (plain "docker compose up") — Docker
# Compose automatically reads a .env file at the repo root and substitutes
# ${VAR} references in docker-compose.yml with it. Copy this file to .env
# and fill in real values; .env itself is gitignored so it never gets
# committed.
#
# Everything here is optional. Leaving it blank just means the AI features
# show "not configured" instead of failing — the rest of the app works fine
# either way.

# Anthropic API key — powers the AI Bid/No-Bid Advisor, AI Alert Watchdog,
# RFP requirement extraction, and content-library answer drafting.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — defaults to claude-opus-5 if left blank.
ANTHROPIC_MODEL=claude-opus-5
